# Sentinel dashboard environment — ops flags only (NO secrets here).
# Copy to deploy/sentinel.env (git-ignored). The admin password hash and session
# secret live in data/dashboard.json (also git-ignored) — do NOT duplicate them.
#
# Full control (0): scans can be triggered from the dashboard.
# View-only   (1): read-only — the trigger endpoint and controls are disabled.
SENTINEL_DASH_READONLY=0
