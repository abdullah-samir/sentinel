[Unit]
Description=Sentinel ngrok tunnel (public URL for the dashboard)
Documentation=file:/home/sentinel/sentinel/deploy/README.md
Requires=sentinel-dashboard.service
After=sentinel-dashboard.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/home/sentinel/sentinel
# ngrok must be installed and its authtoken configured for user `sentinel`
# (`ngrok config add-authtoken <TOKEN>`); the reserved domain is the free static URL.
# Upstream is the EXPLICIT IPv4 127.0.0.1:8000 — a bare "8000"/"localhost:8000" makes
# ngrok resolve to IPv6 [::1]:8000 and fail with ERR_NGROK_8012 (connection refused),
# because the dashboard binds IPv4 127.0.0.1. Do not change back to a bare port.
ExecStart=/usr/bin/env ngrok http --url=casing-moving-cactus.ngrok-free.dev 127.0.0.1:8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
