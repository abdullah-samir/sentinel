[Unit]
# Sentinel captive portal — UNPRIVILEGED web service bound to ap_ip:80 (Phase P1).
# It never runs nmcli and never writes NetworkManager config; it forwards validated
# join requests to sentinel-provisioning.service over /run/sentinel/provisioning.sock.
# The AP IP exists only while the hotspot is up, so this unit is ordered after the
# provisioning service and restarts until the address is bindable (then serves).
Description=Sentinel captive provisioning portal (unprivileged, ap_ip:80)
Documentation=file:/home/sentinel/sentinel/deploy/README.md
After=sentinel-provisioning.service
Wants=sentinel-provisioning.service

[Service]
Type=simple
# NOT root. A dedicated unprivileged user; CAP_NET_BIND_SERVICE lets it bind :80.
User=sentinel
Group=sentinel
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
WorkingDirectory=/home/sentinel/sentinel
Environment=SENTINEL_ROOT=/home/sentinel/sentinel
Environment=SENTINEL_PROV_SOCKET=/run/sentinel/provisioning.sock
ExecStart=/home/sentinel/sentinel/venv/bin/python -m dashboard.portal
# Bind fails until the AP IP is up; restart quietly until then.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
